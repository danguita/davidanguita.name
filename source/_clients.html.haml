.clients__container
  - data.clients.each do |key, client|
    - width, height = image_dimensions("clients/#{key}.png")
    = link_to client[:url], class: "client__link" do
      = image_tag "clients/#{key}.png", srcset: "clients/#{key}.png 1x, clients/#{key}@2x.png 2x", alt: client[:name], class: "client__image", loading: "lazy", decoding: "async", width: width, height: height
