- methods = [['mail', 'Email', "mailto:#{data.settings.contact.email}"], ['linkedin', 'LinkedIn', data.settings.services.linkedin], ['github', 'GitHub', data.settings.services.github], ['twitter', 'Twitter', data.settings.services.twitter]]

.contact__items
  - methods.each do |icon_name, label, url|
    .contact__item
      = link_to url, class: 'contact__link' do
        != icon(icon_name)
        %span= label
