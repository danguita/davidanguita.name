---
priority: 1.0
---

%section.home
  .container.home__hero
    %p.home__eyebrow= I18n.t("home.eyebrow")

    .home__identity
      %span.avatar-wrapper{aria: { hidden: 'true' }}
        = my_gravatar
      %span.home__name= I18n.t("home.heading")

    %h1.home__headline!= I18n.t("home.tagline").sub(I18n.t("home.tagline-accent"), %(<span class="accent">#{I18n.t("home.tagline-accent")}</span>))

    .home__actions
      = link_to contact_path, class: 'button button--primary' do
        = I18n.t("home.cta-primary")
        %span.button__arrow{aria: { hidden: 'true' }} &rarr;
      = link_to '#how-i-work', class: 'button button--ghost' do
        = I18n.t("home.cta-secondary")

  %section.home__services#services
    .container
      %p.section__title= I18n.t("services.eyebrow")
      %h2.section__heading= I18n.t("services.heading")
      = partial :about

  %section.home__work#how-i-work
    .container
      %p.section__title= I18n.t("work.eyebrow")
      %h2.section__heading= I18n.t("work.heading")
      .work__steps
        - (1..3).each do |step|
          .work__step
            %span.work__step-number= format('%02d', step)
            %h3.work__step-title= I18n.t("work.step-#{step}-title")
            %p.work__step-text= I18n.t("work.step-#{step}-text")

  %section.home__clients#clients
    .container
      %p.section__title= I18n.t("clients.eyebrow")
      %h2.section__heading= I18n.t("clients.heading")
      %p.section__intro= I18n.t("clients.intro")
      = partial :clients

  %section.home__contact#contact
    .container
      %p.section__title= I18n.t("contact.eyebrow")
      %h2.section__heading= I18n.t("contact.heading")
      %p.section__intro
        = link_to I18n.t("contact.page-feedback"), contact_path
        = I18n.t("contact.service-feedback")
      = partial :contact_methods
      = link_to contact_path, class: 'button button--primary' do
        = I18n.t("home.cta-primary")
        %span.button__arrow{aria: { hidden: 'true' }} &rarr;

  %section.home__latest-articles
    .container
      %p.section__title= I18n.t("articles.eyebrow")
      %h2.section__heading= I18n.t("articles.latest")
      = partial :latest_articles, locals: { limit: 5 }
